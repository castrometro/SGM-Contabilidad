# .env.development.example
# Configuración para Servidor [4] - Desarrollo General
# Conectado a Servidor [5] - Base de Datos de Desarrollo

# Django
DEBUG=True
SECRET_KEY=dev-secret-key-no-importa-en-desarrollo
DJANGO_SETTINGS_MODULE=sgm_backend.settings
ALLOWED_HOSTS=*

# PostgreSQL - Servidor [5]
POSTGRES_HOST=IP_DEL_SERVIDOR_5  # ← Cambiar por IP real del servidor [5]
POSTGRES_PORT=5432
POSTGRES_DB=sgm_dev_db
POSTGRES_USER=sgm_user
POSTGRES_PASSWORD=dev_password_simple

# Redis
REDIS_PASSWORD=dev_redis_pass
REDIS_DB_CONTABILIDAD=1

# Modo desarrollo (sin Gunicorn)
# El docker-compose usará runserver automáticamente si DEBUG=True

# URLs Frontend
VITE_API_BASE_URL=http://IP_SERVIDOR_4:8000/api
VITE_MEDIA_BASE_URL=http://IP_SERVIDOR_4:8000
