# .env.production.example
# Configuración para Servidor [1] - SGM-Contabilidad Producción
# ⚠️ IMPORTANTE: Copiar como .env y cambiar valores reales

# Django
DEBUG=False
SECRET_KEY=GENERAR_UNO_NUEVO_LARGO_Y_ALEATORIO
DJANGO_SETTINGS_MODULE=sgm_backend.settings
ALLOWED_HOSTS=172.17.11.13,172.17.11.18,tu-dominio.com

# PostgreSQL - Servidor [2]
POSTGRES_HOST=172.17.11.14
POSTGRES_PORT=5432
POSTGRES_DB=sgm_db
POSTGRES_USER=sgm_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO_PRODUCCION

# Redis
REDIS_PASSWORD=CAMBIAR_PASSWORD_REDIS_PRODUCCION
REDIS_DB_CONTABILIDAD=1

# Gunicorn (servidor WSGI para producción)
GUNICORN_WORKERS=3
LOG_LEVEL=warning

# URLs Frontend
VITE_API_BASE_URL=http://172.17.11.13:8000/api
VITE_MEDIA_BASE_URL=http://172.17.11.13:8000
