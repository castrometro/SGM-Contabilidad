# .env.example - ejemplo de variables de entorno para desarrollo
# Copia este archivo a .env y edítalo antes de ejecutar en producción.

# PostgreSQL (usado por docker-compose)
POSTGRES_DB=sgm_db
POSTGRES_USER=sgm_user
POSTGRES_PASSWORD=sgm_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
# SECRET_KEY es obligatorio para Django; reemplázalo por uno fuerte en producción.
SECRET_KEY=replace-me-with-a-secure-secret
DEBUG=True

# Redis
REDIS_PASSWORD=redispass

# Django settings module (usado por algunos contenedores/worker)
DJANGO_SETTINGS_MODULE=sgm_backend.settings

# Streamlit (opcional)
REDIS_DB_CONTABILIDAD=1

# ALLOWED_HOSTS (comma separated) - hosts Django aceptará, ej: 127.0.0.1,localhost,172.17.11.13
# Añade tu IP de desarrollo si accedes remotamente.
ALLOWED_HOSTS=172.17.11.18,127.0.0.1,localhost,0.0.0.0,*
